using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("Voice Transcriber Settings");
  default-width: 620;
  default-height: 520;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    Adw.PreferencesPage {

      Adw.PreferencesGroup {
        title: _("API");
        description: _("Configure the OpenAI-compatible transcription endpoint.");

        Adw.EntryRow api_url_row {
          title: _("API URL");
        }

        Adw.PasswordEntryRow api_key_row {
          title: _("API Key");
        }

        Adw.EntryRow model_row {
          title: _("Model");
        }

        Adw.EntryRow language_row {
          title: _("Language (BCP-47)");
        }
      }

      Adw.PreferencesGroup {
        title: _("Audio");

        Adw.SpinRow sample_rate_row {
          title: _("Sample Rate (Hz)");
          subtitle: _("16000 Hz recommended for Whisper");
          adjustment: Gtk.Adjustment {
            lower: 8000;
            upper: 48000;
            step-increment: 1000;
            page-increment: 8000;
            value: 16000;
          };
        }
      }

      Adw.PreferencesGroup {
        title: _("History");

        Adw.ActionRow {
          title: _("View recent transcriptions");
          activatable: true;
          [suffix]
          Gtk.Image { icon-name: "go-next-symbolic"; }
        }
      }

    }
  }
}
