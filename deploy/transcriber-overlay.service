[Unit]
Description=Transcriber Overlay (wlroots/KDE)
Documentation=https://github.com/Craig-StJean/transcriber
After=graphical-session.target
# Start together with the daemon; both can run independently but this is the
# typical pairing on non-GNOME Wayland sessions.
After=transcriber-daemon.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/transcriber-overlay
# The overlay exits with status 0 when the compositor lacks wlr-layer-shell
# (e.g. GNOME), so this does not restart-loop there.
Restart=on-failure
RestartSec=3s

# WAYLAND_DISPLAY comes from the session environment the compositor imports
# into the systemd user manager (uwsm, KDE and GNOME do this; on Sway add
# `exec systemctl --user import-environment WAYLAND_DISPLAY` to its config).
Environment=RUST_LOG=info

# Kept minimal: the overlay needs the Wayland socket, the session bus and the
# virtual-keyboard protocol for direct text injection.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
