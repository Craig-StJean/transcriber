[Unit]
Description=Transcriber update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# install-remote.sh puts the script under $XDG_DATA_HOME (default
# ~/.local/share), so resolve it the same way.
ExecStart=/bin/sh -c 'exec "$${XDG_DATA_HOME:-%h/.local/share}/transcriber/check-update.sh"'

# Hardening: the updater only needs to write the install locations below.
# "-" ignores a path that doesn't exist (e.g. no GNOME extension dir).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-%h/.local/bin -%h/.local/share/transcriber -%E/transcriber -%h/.config/systemd/user -%h/.local/share/dbus-1/services -%h/.local/share/applications -%h/.local/share/gnome-shell/extensions/transcriber@local
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
