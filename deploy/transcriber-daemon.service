[Unit]
Description=Transcriber Daemon
Documentation=https://github.com/Craig-StJean/transcriber
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.transcriber.Daemon

# The sandbox below makes the home directory read-only apart from the
# ReadWritePaths, so create the config/data dirs (and carry over the
# pre-rename "voice-transcriber" directories) outside the sandbox first ("+"
# prefix). %E is $XDG_CONFIG_HOME (default ~/.config); data follows
# $XDG_DATA_HOME if the user manager has it set.
ExecStartPre=+/bin/sh -c 'for d in "%E" "$${XDG_DATA_HOME:-%h/.local/share}"; do if [ -d "$$d/voice-transcriber" ] && [ ! -e "$$d/transcriber" ]; then mv "$$d/voice-transcriber" "$$d/transcriber"; fi; mkdir -p "$$d/transcriber"; done'
ExecStart=%h/.local/bin/transcriber-daemon
Restart=on-failure
RestartSec=3s

Environment=RUST_LOG=info

# Hardening. No ProtectHome=: audio goes through PipeWire/PulseAudio sockets
# under $XDG_RUNTIME_DIR, and the config/data dirs live in $HOME.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# systemd has no specifier for $XDG_DATA_HOME: a custom data dir needs a
# drop-in adding it here. "-" keeps a missing default data dir from failing
# the unit when XDG_DATA_HOME points elsewhere.
ReadWritePaths=%E/transcriber -%h/.local/share/transcriber
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=graphical-session.target
